<?xml version="1.0" encoding="UTF-8"?>
<!--
  Navigate to a single pose and replace its path when RViz sends a new goal.

  The first path is computed once. GoalUpdatedController computes a fresh path
  only when the NavigateToPose action receives a replacement goal, so a second
  RViz goal preempts the active route without periodic replanning or recovery
  manoeuvres.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithGoalPreemption">
      <GoalUpdatedController>
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      </GoalUpdatedController>
      <FollowPath path="{path}" controller_id="MPPI"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
