<xacro:ultrasonic_sensor name="ultrasonic_rear_right" parent="ultrasonic_rear_right_1" xyz="0.475954 0.771874 -0.735779" yaw="1.570796"/>
<xacro:ultrasonic_sensor name="ultrasonic_side_left" parent="ultrasonic_side_left_1" xyz="-0.028052 -0.459881 -0.482779" yaw="0.000000"/>
