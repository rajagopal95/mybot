<?xml version="1.0"?>
<robot name="mybot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       GEOMETRY — computed so body never touches ground.
       Design rule:
         wheel axle is at the BOTTOM FACE of base_link (z = -base_height/2
         in base_link frame).  This guarantees body clears ground by
         wheel_radius regardless of base_height.
         base_joint lifts base_link so wheel bottoms touch ground:
           base_joint_z = wheel_radius - wheel_offset_z
                        = wheel_radius + base_height/2
         Caster joint z is chosen so sphere bottom = wheel bottom.
  ============================================================ -->
  <xacro:property name="base_length"      value="0.4"/>
  <xacro:property name="base_width"       value="0.3"/>
  <xacro:property name="base_height"      value="0.15"/>

  <xacro:property name="wheel_radius"     value="0.08"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_separation" value="0.34"/>

  <!-- axle at base bottom face -->
  <xacro:property name="wheel_offset_z"   value="${-base_height/2}"/>

  <!-- caster: same radius as wheel so contact plane is identical -->
  <xacro:property name="caster_radius"    value="0.05"/>
  <!-- caster joint z so sphere bottom = ground:
       base_link_z + caster_joint_z - caster_radius = 0 (ground at base_footprint z)
       base_link_z = wheel_radius - wheel_offset_z = wheel_radius + base_height/2
       caster_joint_z = caster_radius - base_link_z
                      = caster_radius - wheel_radius - base_height/2             -->
  <xacro:property name="caster_joint_z"  value="${caster_radius - wheel_radius - base_height/2}"/>

  <!-- ============================================================ MATERIALS -->
  <material name="grey"> <color rgba="0.5 0.5 0.5 1"/> </material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/> </material>

  <!-- ============================================================ BASE -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.0578" ixy="0" ixz="0"
               iyy="0.0911" iyz="0"
               izz="0.1156"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius - wheel_offset_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ WHEELS -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.00052" ixy="0" ixz="0"
                 iyy="0.00063" iyz="0"
                 izz="0.00052"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation/2} ${wheel_offset_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2" friction="0.1"/>
      <limit effort="10.0" velocity="10.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ============================================================ CASTERS -->
  <xacro:macro name="caster" params="prefix x_offset y_offset">
    <link name="caster_${prefix}_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0"
                 izz="0.0001"/>
      </inertial>
    </link>

    <joint name="caster_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="caster_${prefix}_link"/>
      <origin xyz="${x_offset} ${y_offset} ${caster_joint_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="caster_${prefix}_link">
      <material>Gazebo/Black</material>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>100000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="${ base_length/2 - 0.05}" y_offset="0.0"/>
  <xacro:caster prefix="back"  x_offset="${-base_length/2 + 0.05}" y_offset="0.0"/>

  <!-- ============================================================ ROS2_CONTROL -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ============================================================ GAZEBO PLUGINS -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find mybot_gazebo)/config/controllers.yaml</parameters>
      <ros>
        <remapping>diff_drive_controller/odom:=/odom</remapping>
        <remapping>diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- ============================================================ GAZEBO LINK PROPS -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <!-- ============================================================ LIDAR -->
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.05"/>

  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 ${base_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="laser_link">
    <self_collide>false</self_collide>
    <sensor name="lidar_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <frame_name>laser_link</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
        <!-- Ignore the robot's own links -->
        <ignore>
          <link>base_link</link>
          <link>laser_link</link>
          <link>left_wheel_link</link>
          <link>right_wheel_link</link>
          <link>caster_front_link</link>
          <link>caster_back_left_link</link>
          <link>caster_back_right_link</link>
        </ignore>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================ IMU -->
  <xacro:property name="imu_size" value="0.02"/>

  <link name="imu_link">
    <visual>
      <geometry><box size="${imu_size} ${imu_size} ${imu_size}"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0"
               iyy="1e-7" iyz="0"
               izz="1e-7"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <material>Gazebo/Black</material>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

</robot>
