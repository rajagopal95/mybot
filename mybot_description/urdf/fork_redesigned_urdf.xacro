  <xacro:mesh_link name="center_screw_link" mesh="center_screw_link" ox="5.55111512e-17" oy="-4.4408921e-16" oz="-1.11022302e-16" rr="2.06766524e-15" rp="1.05644603e-15" ry="-6.71855004e-16" mass="0.0120485191" cx="2.6848987e-07" cy="3.58281948e-07" cz="-0.00348950414" ixx="1e-06" ixy="1.51509e-22" ixz="2.41736e-23" iyy="1e-06" iyz="4.7113e-23" izz="1e-06"/>
  <xacro:mesh_link name="fork_link" mesh="fork_link" ox="0.25" oy="0.02" oz="-0.0114" rr="-5.72118873e-18" rp="-1.57079629" ry="0" mass="0.730873983" cx="-7.21644966e-16" cy="0.02" cz="-0.0114" ixx="0.000215894" ixy="2.34625e-10" ixz="-1.64315e-11" iyy="0.0153345" iyz="2.59913e-11" izz="0.0153345"/>
  <xacro:mesh_link name="left_fork_h_link" mesh="left_fork_h_link" ox="-0.017" oy="0.02" oz="-0.15" rr="2.07042645e-15" rp="8.56143293e-16" ry="4.93879172e-16" mass="0.219262195" cx="-0.017" cy="0.02" cz="-0.075" ixx="0.000443501" ixy="-2.59726e-11" ixz="-1.77696e-12" iyy="0.000443501" iyz="4.64424e-11" izz="6.47679e-05"/>
  <xacro:mesh_link name="right_fork_h_link" mesh="right_fork_h_link" ox="0.017" oy="0.02" oz="-0.15" rr="3.14159265" rp="-8.26537346e-16" ry="3.14159265" mass="0.219262195" cx="0.017" cy="0.02" cz="-0.075" ixx="0.000443501" ixy="-5.75116e-11" ixz="-3.95448e-12" iyy="0.000443501" iyz="4.64424e-11" izz="6.47681e-05"/>
  <xacro:mesh_link_col name="left_fork_link" mesh="left_fork_link" ox="-0.017" oy="0.5" oz="0.02" rr="1.57079633" rp="1.23495037e-15" ry="4.97899625e-17" mass="1.46174797" cx="-0.017" cy="0.5" cz="0.02" ixx="0.122028" ixy="-2.268e-10" ixz="-4.95408e-13" iyy="0.000431788" iyz="2.14341e-11" izz="0.122028">
    <collision>
        <origin xyz="-0.017 0.5 0.02" rpy="0 0 0"/>
        <geometry><box size="0.04 1.0 0.04"/></geometry>
      </collision>
  </xacro:mesh_link_col>
  <xacro:mesh_link_col name="right_fork_link" mesh="right_fork_link" ox="0.02" oy="0.5" oz="0.017" rr="1.57079633" rp="-4.47730267e-16" ry="3.14159265" mass="1.46174797" cx="0.02" cy="0.5" cz="0.017" ixx="0.122028" ixy="-3.33411e-09" ixz="-9.5039e-13" iyy="0.000431786" iyz="1.95695e-12" izz="0.122028">
    <collision>
        <origin xyz="0.02 0.5 0.017" rpy="0 0 0"/>
        <geometry><box size="0.04 1.0 0.04"/></geometry>
      </collision>
  </xacro:mesh_link_col>

  <!-- ===================== JOINTS ===================== -->
  <joint name="base_link_to_left_holder_link" type="fixed"><parent link="chassis_link"/><child link="left_holder_link"/><origin xyz="0.098 0.592380795 0" rpy="0 0 0"/></joint>
  <joint name="base_link_to_right_holder_link" type="fixed"><parent link="chassis_link"/><child link="right_holder_link"/><origin xyz="-0.535955 0.622380795 0" rpy="0 0 0"/></joint>
  <joint name="base_link_to_right_slot_link" type="fixed"><parent link="chassis_link"/><child link="right_slot_link"/><origin xyz="-0.527954692 0.454880795 0.005" rpy="0 0 0"/></joint>
  <joint name="base_link_to_left_slot_link" type="fixed"><parent link="chassis_link"/><child link="left_slot_link"/><origin xyz="0.0900453082 0.454880795 0.005" rpy="0 0 0"/></joint>
  <joint name="base_link_to_rear_slot_link" type="fixed"><parent link="chassis_link"/><child link="rear_slot_link"/><origin xyz="-0.218954692 0.76 0.005" rpy="0 0 0"/></joint>
  <joint name="left_holder_link_to_left_motor_link" type="fixed"><parent link="left_holder_link"/><child link="left_motor_link"/><origin xyz="0.0345 0.0149999999 -0.034" rpy="0 0 0"/></joint>
  <joint name="right_holder_link_to_right_motor_link" type="fixed"><parent link="right_holder_link"/><child link="right_motor_link"/><origin xyz="-0.0345 -0.0149999999 -0.034" rpy="0 0 0"/></joint>
  <joint name="right_slot_link_to_right_caster_link" type="fixed"><parent link="right_slot_link"/><child link="right_caster_link"/><origin xyz="0.034 0.5 -9.05525654e-16" rpy="0 0 0"/></joint>
  <joint name="right_slot_link_to_bottom_front_link" type="fixed"><parent link="right_slot_link"/><child link="bottom_front_link"/><origin xyz="0.037 -1.11022302e-16 0.037" rpy="0 0 0"/></joint>
  <joint name="right_slot_link_to_front_right_link" type="fixed"><parent link="right_slot_link"/><child link="front_right_link"/><origin xyz="1.22124533e-15 -1.11022302e-16 0.04" rpy="0 0 0"/></joint>
  <joint name="left_slot_link_to_left_caster_link" type="fixed"><parent link="left_slot_link"/><child link="left_caster_link"/><origin xyz="-0.034 0.5 1.04170145e-15" rpy="0 0 0"/></joint>
  <joint name="left_slot_link_to_front_left_link" type="fixed"><parent link="left_slot_link"/><child link="front_left_link"/><origin xyz="9.02056208e-16 2.22044605e-16 0.04" rpy="0 0 0"/></joint>
  <joint name="rear_slot_link_to_rear_right_link" type="fixed"><parent link="rear_slot_link"/><child link="rear_right_link"/><origin xyz="-0.272 -0.0112 0.04" rpy="0 0 0"/></joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="left_motor_link"/><child link="right_wheel_link"/>
    <origin xyz="0.01375 -4.4408921e-16 -1.66533454e-16" rpy="0 0 0"/>
    <!-- -1 with the negative radius multipliers in fork_controllers.yaml.
         Both flips cancel, so a forward command still drives toward the forks
         and wheel-tick odometry keeps that same sign. -->
    <axis xyz="-1 0 0"/>
    <dynamics damping="0.2" friction="0.0"/>

    <limit effort="300" velocity="20"/>
  </joint>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="right_motor_link"/><child link="left_wheel_link"/>
    <origin xyz="-0.01375 0 -3.46944695e-17" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>   <!-- same sign as right_wheel_joint -->
    <dynamics damping="0.2" friction="0.0"/>
    <limit effort="300" velocity="20"/>
  </joint>
  <joint name="front_right_link_to_right_panel_link" type="fixed"><parent link="front_right_link"/><child link="right_panel_link"/><origin xyz="-0.003 0.003 0.65" rpy="0 0 0"/></joint>
  <joint name="front_left_link_to_top_tray_link" type="fixed"><parent link="front_left_link"/><child link="top_tray_link"/><origin xyz="-0.0361213203 0.0391213203 0.65" rpy="0 0 0"/></joint>
  <joint name="front_left_link_to_left_panel_link" type="fixed"><parent link="front_left_link"/><child link="left_panel_link"/><origin xyz="0.003 0.003 0.65" rpy="0 0 0"/></joint>
  <joint name="front_left_link_to_front_panel_link" type="fixed"><parent link="front_left_link"/><child link="front_panel_link"/><origin xyz="1.02834408e-14 2.22044605e-16 0.65" rpy="0 0 0"/></joint>
  <joint name="rear_right_link_to_lead_top_link" type="fixed"><parent link="rear_right_link"/><child link="lead_top_link"/><origin xyz="-0.04 -0.023 1.1" rpy="0 0 0"/></joint>
  <joint name="rear_right_link_to_back_panel_link" type="fixed"><parent link="rear_right_link"/><child link="back_panel_link"/><origin xyz="-0.037 0.014 1.30451205e-15" rpy="0 0 0"/></joint>
  <joint name="top_tray_link_to_lidar_link" type="fixed"><parent link="top_tray_link"/><child link="lidar_link"/><origin xyz="-0.273000005 0.1137016 0.0005" rpy="0 0 0"/></joint>
  <joint name="top_tray_link_to_imu_link" type="fixed"><parent link="top_tray_link"/><child link="imu_mount_link"/><origin xyz="-0.273000005 0.1137016 0.0005" rpy="0 0 0"/></joint>
  <joint name="lead_top_link_to_rear_left_link" type="fixed"><parent link="lead_top_link"/><child link="rear_left_link"/><origin xyz="0.627 0.034 -3.77475828e-14" rpy="0 0 0"/></joint>
  <joint name="lead_top_link_to_lead_holder_link_1" type="fixed"><parent link="lead_top_link"/><child link="lead_holder_link_1"/><origin xyz="0.3135 0.037 0.0314" rpy="0 0 0"/></joint>
  <joint name="rear_left_link_to_lead_holder_link" type="fixed"><parent link="rear_left_link"/><child link="lead_holder_link"/><origin xyz="-0.003 0.003 -1.1" rpy="0 0 0"/></joint>
  <joint name="lead_holder_link_1_to_lead_motor_link" type="fixed"><parent link="lead_holder_link_1"/><child link="lead_motor_link"/><origin xyz="-7.04094838e-11 0.034 -0.0225" rpy="0 0 0"/></joint>
  <joint name="lead_holder_link_to_bottom_screw_link" type="fixed"><parent link="lead_holder_link"/><child link="bottom_screw_link"/><origin xyz="-0.312 0.0358 0.037" rpy="0 0 0"/></joint>
  <joint name="lead_motor_link_to_forklift_coupling" type="fixed"><parent link="lead_motor_link"/><child link="forklift_coupling"/><origin xyz="-8.32667268e-17 0 -0.02475" rpy="0 0 0"/></joint>
  <joint name="forklift_coupling_to_lead_screw_link" type="fixed"><parent link="forklift_coupling"/><child link="lead_screw_link"/><origin xyz="0 0 -0.0175" rpy="0 0 0"/></joint>
  <!-- Lift: CAD zero pose = forks lowest. Axis now +Z (was -Z with limits 0.3..0.9,
       which drove the forks 0.17-0.77 m below the floor). Adjust upper to your mast. -->
  <joint name="forklift_coupling_to_center_holder_link" type="prismatic">
    <parent link="forklift_coupling"/><child link="center_holder_link"/>
    <!-- Child frame placed at the carriage CoM (~0.96 m down the mast) so ODE
         does not see a 1 m lever arm on a 64 g link. -->
    <origin xyz="0 0 -0.995" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="200" friction="50"/>
    <limit lower="0.0" upper="0.8" effort="500" velocity="0.2"/>
  </joint>
  <joint name="center_holder_link_to_center_screw_link" type="fixed"><parent link="center_holder_link"/><child link="center_screw_link"/><origin xyz="-5.55111512e-17 3.33066907e-16 0.005" rpy="0 0 0"/></joint>
  <joint name="center_holder_link_to_fork_link" type="fixed"><parent link="center_holder_link"/><child link="fork_link"/><origin xyz="-2.77555756e-17 0.0235407002 -0.0065" rpy="0 0 0"/></joint>
  <joint name="fork_link_to_left_fork_h_link" type="fixed"><parent link="fork_link"/><child link="left_fork_h_link"/><origin xyz="0.25 0.04 0.0056" rpy="0 0 0"/></joint>
  <joint name="fork_link_to_right_fork_h_link" type="fixed"><parent link="fork_link"/><child link="right_fork_h_link"/><origin xyz="-0.25 0.04 0.0056" rpy="0 0 0"/></joint>
  <joint name="left_fork_h_link_to_left_fork_link" type="fixed"><parent link="left_fork_h_link"/><child link="left_fork_link"/><origin xyz="6.9388939e-18 0.04 -0.15" rpy="0 0 0"/></joint>
  <joint name="right_fork_h_link_to_right_fork_link" type="fixed"><parent link="right_fork_h_link"/><child link="right_fork_link"/><origin xyz="-2.77555756e-16 0.04 -0.15" rpy="0 0 0"/></joint>

  <!-- ===================== SENSOR FRAMES (ROS convention, x forward) ===================== -->
  <link name="laser_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="lidar_link"/><child link="laser_link"/>
    <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="imu_mount_link"/><child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
  </joint>

  <!-- ===================== ROS2_CONTROL (same as mybot.urdf.xacro) ===================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Lift: state-only (passive) so joint_state_broadcaster publishes it and
         robot_state_publisher can emit TF for the whole fork carriage subtree.
         Add a position command interface + controller later to actuate it. -->
    <joint name="forklift_coupling_to_center_holder_link">
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find mybot_gazebo)/config/fork_controllers.yaml</parameters>
      <ros>
        <remapping>diff_drive_controller/odom:=/wheel_odom</remapping>
        <remapping>diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- ===================== GAZEBO LINK PROPS ===================== -->
  <gazebo reference="chassis_link">
    <material>Gazebo/Grey</material>
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.2</mu1><mu2>1.2</mu2><kp>1000000.0</kp><kd>100.0</kd><minDepth>0.001</minDepth><maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.2</mu1><mu2>1.2</mu2><kp>1000000.0</kp><kd>100.0</kd><minDepth>0.001</minDepth><maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="left_caster_link">
    <mu1>0.05</mu1><mu2>0.05</mu2><kp>1000000.0</kp><kd>10.0</kd><minDepth>0.001</minDepth><maxVel>1.0</maxVel>
  </gazebo>
  <gazebo reference="right_caster_link">
    <mu1>0.05</mu1><mu2>0.05</mu2><kp>1000000.0</kp><kd>10.0</kd><minDepth>0.001</minDepth><maxVel>1.0</maxVel>
  </gazebo>

  <!-- ===================== LIDAR (same as mybot.urdf.xacro, frame laser_link) ===================== -->
  <gazebo reference="laser_link">
    <sensor name="lidar_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <!-- 90 deg to 270 deg. 0 is +X, toward the forks. -->
            <min_angle>1.5708</min_angle>
            <max_angle>4.7124</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <frame_name>laser_link</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== IMU (same as mybot.urdf.xacro, frame imu_link) ===================== -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

</robot>
