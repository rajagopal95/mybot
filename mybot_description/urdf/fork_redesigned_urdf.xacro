<?xml version="1.0"?>
<!-- fork_redesigned_urdf.xacro  (cleaned for Gazebo Classic + ros2_control)
     Changes vs. the raw SolidWorks export:
       * meshes now load from mybot_description (was forklift_description)
       * +X is forward (CAD forward is +Y): base_footprint -> base_link -> chassis_link(rotated -90 deg)
       * wheel joints renamed left_wheel_joint / right_wheel_joint, axes fixed so +vel = forward
         (CAD "left"/"right" were mirrored w.r.t. ROS once the forks point forward)
       * inertias recomputed about each link's COM (exporter wrote them about the assembly origin)
       * mesh collisions replaced by simple primitives (wheels, casters, body box, forks)
       * lift joint axis/limits fixed (old limits pushed the forks below the floor)
       * ros2_control + gazebo_ros2_control + lidar (laser_link) + IMU (imu_link) from mybot.urdf.xacro -->
<robot name="fork_redesigned" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_camera" default="false"/>  <!-- accepted for launch compatibility; no camera on this model -->

  <xacro:property name="mesh_pkg"     value="package://mybot_description/meshes"/>
  <xacro:property name="mesh_scale"   value="0.001"/>

  <!-- wheel_radius ~0.053 m is derived from the exported wheel inertia (solid disc). Verify against
       left_wheel_link.stl bounding box and keep controllers.yaml wheel_radius identical. -->
  <xacro:property name="wheel_radius"     value="0.053"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <!-- Contact centers are 0.771 m apart (link origins are 0.730 m; the collision
       cylinders sit outboard of those origins). Odometry uses the contact track. -->
  <xacro:property name="wheel_separation" value="0.771455"/>

  <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>

  <!-- visual-only link (inertia about COM) -->
  <xacro:macro name="mesh_link" params="name mesh ox oy oz rr rp ry mass cx cy cz ixx ixy ixz iyy iyz izz">
    <link name="${name}">
      <visual>
        <origin xyz="${ox} ${oy} ${oz}" rpy="${rr} ${rp} ${ry}"/>
        <geometry><mesh filename="${mesh_pkg}/${mesh}.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/></geometry>
        <material name="grey"/>
      </visual>
      <inertial>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- same, plus a primitive collision passed as a block -->
  <xacro:macro name="mesh_link_col" params="name mesh ox oy oz rr rp ry mass cx cy cz ixx ixy ixz iyy iyz izz *col">
    <link name="${name}">
      <visual>
        <origin xyz="${ox} ${oy} ${oz}" rpy="${rr} ${rp} ${ry}"/>
        <geometry><mesh filename="${mesh_pkg}/${mesh}.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/></geometry>
        <material name="grey"/>
      </visual>
      <xacro:insert_block name="col"/>
      <inertial>
        <origin xyz="${cx} ${cy} ${cz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ===================== ROS base frames (x forward, z up) ===================== -->
  <!-- Tiny inertia so Gazebo does not invent a 1 kg CoM on the floor. -->
  <link name="base_footprint">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>   <!-- base_link = wheel-axle midpoint -->
  </joint>
  <!-- Battery inside the lower chassis. CAD parts alone put the assembled
       CoM at x=+0.04 m, z=+0.41 m (tall panels). This 200 kg pack pulls the
       model CoM to about x=+0.12 m, z=+0.25 m, inside the body and over the
       wheelbase, so the robot sits still until cmd_vel is applied.
       Inertia is a 0.30 x 0.25 x 0.12 m box. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.15 0 0.13" rpy="0 0 0"/>
      <mass value="200.0"/>
      <inertia ixx="0.64" ixy="0" ixz="0" iyy="1.74" iyz="0" izz="2.29"/>
    </inertial>
  </link>
  <!-- CAD root (forward = +Y) rotated so CAD +Y -> ROS +X; origin placed so the wheel-axle midpoint is at base_link origin -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/><child link="chassis_link"/>
    <origin xyz="-0.607380795 -0.2189775 0.034" rpy="0 0 ${-pi/2}"/>
  </joint>

  <!-- ===================== LINKS ===================== -->

  <xacro:mesh_link_col name="chassis_link" mesh="base_link" ox="0" oy="0" oz="0" rr="0" rp="-0" ry="0" mass="8.10420284" cx="-0.218971913" cy="0.607435227" cz="0.0025" ixx="0.060414" ixy="-9.82363e-09" ixz="1.19629e-11" iyy="0.311763" iyz="2.94236e-11" izz="0.372143">
    <collision>
        <!-- simple body box (CAD frame): panels span x -0.54..0.10, y 0.45..0.77, z 0..0.68.
             Top is kept just BELOW the lidar plane (z=0.696) so the lidar never sees the body. -->
        <origin xyz="-0.219 0.61 0.34" rpy="0 0 0"/>
        <geometry><box size="0.66 0.33 0.68"/></geometry>
      </collision>
  </xacro:mesh_link_col>
  <xacro:mesh_link name="left_holder_link" mesh="left_holder_link" ox="-0.008" oy="-0.005" oz="-1.33226763e-17" rr="-3.14159265" rp="2.77555756e-16" ry="1.57079633" mass="0.0616621529" cx="0.0216206991" cy="0.015" cz="-0.0101518474" ixx="1.89239e-05" ixy="2.12475e-12" ixz="6.06948e-06" iyy="2.15824e-05" iyz="8.0687e-13" izz="1.96835e-05"/>
  <xacro:mesh_link name="right_holder_link" mesh="right_holder_link" ox="0.008" oy="0.005" oz="0" rr="3.14159265" rp="3.88578059e-16" ry="-1.57079633" mass="0.0616621529" cx="-0.0216206991" cy="-0.015" cz="-0.0101518474" ixx="1.89239e-05" ixy="3.31922e-11" ixz="-6.06948e-06" iyy="2.15825e-05" iyz="8.0687e-13" izz="1.96835e-05"/>
  <xacro:mesh_link name="right_slot_link" mesh="right_slot_link" ox="0.017" oy="-5.55111512e-17" oz="0.02" rr="-1.57079633" rp="3.45688629e-14" ry="-1.2246468e-16" mass="0.730873983" cx="0.017" cy="0.25" cz="0.02" ixx="0.0153345" ixy="2.64752e-10" ixz="-1.86446e-12" iyy="0.000215894" iyz="5.45464e-11" izz="0.0153345"/>
  <xacro:mesh_link name="left_slot_link" mesh="left_slot_link" ox="-0.017" oy="1.66533454e-16" oz="0.02" rr="-1.57079633" rp="2.41451146e-14" ry="-6.69535287e-17" mass="0.730873983" cx="-0.017" cy="0.25" cz="0.02" ixx="0.0153345" ixy="2.9992e-11" ixz="3.58991e-12" iyy="0.000215894" iyz="5.45464e-11" izz="0.0153345"/>
  <xacro:mesh_link name="rear_slot_link" mesh="rear_slot_link" ox="-0.272" oy="-0.017" oz="0.02" rr="1.57772181e-30" rp="1.57079629" ry="0" mass="0.795190893" cx="1.08246745e-15" cy="-0.017" cz="0.02" ixx="0.000234892" ixy="-3.54108e-10" ixz="3.54952e-12" iyy="0.0197279" iyz="3.7475e-11" izz="0.0197279"/>
  <xacro:mesh_link name="left_motor_link" mesh="left_motor_link" ox="-0.1325" oy="-0.607380795" oz="0.034" rr="-1.57079633" rp="7.07767178e-16" ry="-1.57079633" mass="0.127849876" cx="-0.0257459503" cy="-5.36493923e-06" cz="0.00667674448" ixx="2.28358e-05" ixy="-2.59308e-09" ixz="1.59683e-06" iyy="5.62893e-05" iyz="3.12807e-09" izz="5.60428e-05"/>
  <xacro:mesh_link name="right_motor_link" mesh="right_motor_link" ox="0.570455" oy="-0.607380795" oz="0.034" rr="0" rp="0" ry="0" mass="0.127849876" cx="0.0257459503" cy="1.69131048e-06" cz="0.0066762682" ixx="2.28366e-05" ixy="-2.32975e-08" ixz="-1.59954e-06" iyy="5.62904e-05" iyz="-6.85699e-09" izz="5.60427e-05"/>
  <xacro:mesh_link_col name="right_caster_link" mesh="right_caster_link" ox="0.493954692" oy="-0.954880795" oz="-0.005" rr="0" rp="0" ry="0" mass="0.122715632" cx="-0.0325000884" cy="-0.0104017259" cz="-0.0394206707" ixx="0.000158658" ixy="5.43329e-11" ixz="-1.56107e-11" iyy="9.14687e-05" iyz="4.81359e-05" izz="0.000100934">
    <collision>
        <origin xyz="-0.0325000884 -0.0104017259 -0.0394206707" rpy="0 0 0"/>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
  </xacro:mesh_link_col>
  <xacro:mesh_link name="bottom_front_link" mesh="bottom_front_link" ox="-0.085" oy="0.02" oz="-0.017" rr="-9.65639719e-15" rp="1.57079631" ry="0" mass="0.795190893" cx="0.272" cy="0.02" cz="-0.017" ixx="0.000234892" ixy="-2.73803e-11" ixz="3.5495e-12" iyy="0.0197279" iyz="-3.885e-12" izz="0.0197279"/>
  <xacro:mesh_link name="front_right_link" mesh="front_right_link" ox="0.017" oy="0.02" oz="-2.8449465e-16" rr="-2.74172418e-16" rp="1.62347755e-14" ry="-9.33550431e-16" mass="0.950136178" cx="0.017" cy="0.02" cz="0.325" ixx="0.033593" ixy="-4.08587e-10" ixz="-1.29577e-10" iyy="0.033593" iyz="-2.80246e-10" izz="0.000280661"/>
