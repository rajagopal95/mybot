<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       DEPTH CAMERA — standalone macro, only instantiated when
       use_camera:=true is passed at xacro-processing time.
       Mounted on base_link, facing forward (+x).
  ============================================================ -->
  <xacro:macro name="depth_camera" params="parent_link:=base_link">

    <xacro:property name="camera_size" value="0.03"/>

    <link name="camera_link">
      <visual>
        <geometry><box size="${camera_size} 0.06 ${camera_size}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><box size="${camera_size} 0.06 ${camera_size}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-6" ixy="0" ixz="0"
                 iyy="1e-6" iyz="0"
                 izz="1e-6"/>
      </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="camera_link"/>
      <!-- front edge of base, roughly LiDAR height -->
      <origin xyz="${base_length/2 - 0.02} 0 ${base_height/4}" rpy="0 0 0"/>
    </joint>

    <!-- optical frame — REP-103: z-forward, x-right, y-down.
         RTAB-Map/image pipelines expect data in this frame, not camera_link's
         REP-105 frame (x-forward, z-up), so this static rotation is required. -->
    <link name="camera_depth_optical_frame"/>

    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child  link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="camera_link">
      <material>Gazebo/Black</material>
      <sensor name="depth_camera" type="depth">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov> <!-- 60 deg -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera</namespace>
            <remapping>depth_camera/image_raw:=depth_camera/image_raw</remapping>
            <remapping>depth_camera/depth/image_raw:=depth_camera/depth/image_raw</remapping>
            <remapping>depth_camera/camera_info:=depth_camera/camera_info</remapping>
          </ros>
          <camera_name>depth_camera</camera_name>
          <frame_name>camera_depth_optical_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
